# MkDocs build output. Regenerated by `mkdocs build` and by the Documentation
# workflow on every push, so a committed copy is stale immediately and makes
# every content change look like a few thousand lines of churn.
/site/

# Python, for anyone building the docs locally
.venv/
venv/
__pycache__/
*.py[cod]

# Editors and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
